{
  "name": "cmms-diario-de-bordo",
  "version": "1.0.0",
  "description": "Gestão Inteligente de Manutenção Veicular (CMMS / Diário de Bordo Inteligente) com Google Apps Script, Google Sheets e Gemini API",
  "main": "Code.gs",
  "scripts": {
    "login": "clasp login",
    "create": "clasp create --type sheets --title \"CMMS_Diario_De_Bordo\"",
    "push": "clasp push",
    "deploy": "clasp deploy --description \"Deploy CMMS WebApp\"",
    "open": "clasp open"
  },
  "devDependencies": {
    "@google/clasp": "^3.3.0",
    "@types/google-apps-script": "^2.0.12",
    "typescript": "^5.9.3"
  }
}
